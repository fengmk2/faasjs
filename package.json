{
  "name": "faasjs-mono",
  "version": "8.0.0-beta.34",
  "private": true,
  "description": "A Rails-inspired, curated full-stack TypeScript framework for database-driven React business applications.",
  "workspaces": [
    "packages/*",
    "docs",
    "templates/*",
    "benchmarks"
  ],
  "type": "module",
  "scripts": {
    "lint": "vp check --fix *",
    "test": "vp test run",
    "ci": "vp test run --silent --coverage",
    "pack": "vp pack",
    "pub": "npm run clean && vp pack && npm run doc && node publish.ts",
    "doc": "node packages/docgen/src/cli.ts all",
    "clean": "rimraf packages/*/node_modules packages/*/dist coverage packages/*/*.log tmp *.log",
    "prepare": "vp config"
  },
  "overrides": {
    "@voidzero-dev/vite-plus-core": "https://pkg.pr.new/voidzero-dev/vite-plus/@voidzero-dev/vite-plus-core@d0b407c85b560c2470395176c9f1c838b5ca8af8",
    "@voidzero-dev/vite-plus-prompts": "https://pkg.pr.new/voidzero-dev/vite-plus/@voidzero-dev/vite-plus-prompts@d0b407c85b560c2470395176c9f1c838b5ca8af8",
    "@voidzero-dev/vite-plus-test": "https://pkg.pr.new/voidzero-dev/vite-plus/@voidzero-dev/vite-plus-test@d0b407c85b560c2470395176c9f1c838b5ca8af8",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.14.1"
}
