{
  "name": "faasjs-mono",
  "version": "8.0.0-beta.42",
  "private": true,
  "description": "A Rails-inspired, curated full-stack TypeScript framework for database-driven React business applications.",
  "workspaces": [
    "packages/*",
    "docs",
    "templates/*",
    "benchmarks"
  ],
  "type": "module",
  "scripts": {
    "lint": "vp check --fix *",
    "test": "vp test run",
    "ci": "vp test run --silent --coverage",
    "pack": "vp pack",
    "pub": "npm run clean && vp pack && npm run doc && node publish.ts",
    "doc": "node packages/docgen/src/cli.ts all",
    "clean": "rimraf packages/*/node_modules packages/*/dist coverage packages/*/*.log tmp *.log",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.9",
    "vite-plus": "0.0.0-commit.1d7ba811f0e456640b0e761e8e8acf77d1ad3251",
    "vitest": "4.1.9"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.0.0-commit.1d7ba811f0e456640b0e761e8e8acf77d1ad3251",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.17.0"
}
